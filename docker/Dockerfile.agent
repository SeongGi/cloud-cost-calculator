# Cost agent: FastAPI + LangGraph, talks to Ollama on the host
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.8.15 /uv /usr/local/bin/uv
WORKDIR /app
COPY apps/agent/pyproject.toml apps/agent/uv.lock apps/agent/.python-version ./
RUN uv sync --frozen --no-dev --no-install-project
COPY apps/agent/main.py apps/agent/langgraph.json ./
COPY apps/agent/src ./src
COPY apps/agent/pricing ./pricing
RUN useradd -u 1001 agent && mkdir -p /data/catalogs /data/cache /data/settings && chown -R agent /app /data && chmod 700 /data/settings
USER agent
ENV PYTHONUNBUFFERED=1 CATALOG_DIR=/data/catalogs AWS_PRICE_CACHE=/data/cache SETTINGS_DIR=/data/settings
EXPOSE 8123
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8123/health',timeout=4)"
CMD ["/app/.venv/bin/uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8123"]
