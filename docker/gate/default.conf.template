# The only public port. A request passes when it comes from loopback, or from the trusted
# reverse-proxy peer AND carries the shared secret header the proxy adds (X-Proxy-Secret).
# The secret matters because the container runtime (OrbStack) may rewrite the peer address of
# every forwarded connection to its own gateway, so the peer alone cannot tell the proxy apart.

# realip rewrites $remote_addr before access checks, so the peer is read from $realip_remote_addr.
geo $realip_remote_addr $peer_kind {
    default none;
    ${TRUSTED_PROXY_IP} proxy;
    127.0.0.1 loopback;
}

map_hash_bucket_size 128;
map "$peer_kind|$http_x_proxy_secret" $allowed {
    default 0;
    "~^loopback\|" 1;
    "proxy|${PROXY_SECRET}" 1;
}

# Logged instead of the header itself, so a wrong proxy setup is visible without exposing the secret.
map $http_x_proxy_secret $secret_state {
    "" absent;
    "${PROXY_SECRET}" ok;
    default mismatch;
}
log_format gate '$remote_addr peer=$realip_remote_addr secret=$secret_state [$time_local] '
                '"$request" $status $body_bytes_sent "$http_user_agent"';
access_log /var/log/nginx/access.log gate;

# Only API calls are limited; one page load fetches many static chunks.
limit_req_zone $binary_remote_addr zone=api:10m rate=120r/m;

server {
    listen 8080;
    server_tokens off;
    client_max_body_size 1m;

    set_real_ip_from ${TRUSTED_PROXY_IP};
    real_ip_header X-Real-IP;

    if ($allowed = 0) {
        return 403;
    }

    # Admin pages go through Google login (oauth2-proxy). The variable lets the gate start even when
    # the auth container is not running (admin pages then answer 502, everything else works).
    location ~ ^/(admin|oauth2|api/admin)(/|$) {
        limit_req zone=api burst=20 nodelay;
        limit_req_status 429;
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $auth_upstream http://auth:4180;
        proxy_pass $auth_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host ${ADMIN_PUBLIC_HOST};
        # oauth2-proxy trusts these in reverse-proxy mode; only the gate may set them.
        proxy_set_header X-Forwarded-Uri "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Auth-Request-Redirect "";
        proxy_set_header X-Admin-Gate "";
        proxy_set_header X-Forwarded-Email "";
        proxy_set_header X-Forwarded-User "";
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        limit_req_status 429;
        include /etc/nginx/conf.d/proxy.inc;
    }

    location / {
        include /etc/nginx/conf.d/proxy.inc;
    }
}

# Internal only (not published): oauth2-proxy forwards signed-in admin requests here, and this
# server marks them with the shared secret the app checks.
server {
    listen 8081;
    server_tokens off;
    # Only oauth2-proxy, on the dedicated admin network, may hand requests to the app as admin.
    allow 10.251.77.0/29;
    deny all;
    client_max_body_size 64k;

    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $http_x_real_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Email $http_x_forwarded_email;
        proxy_set_header X-Admin-Gate "${ADMIN_GATE_SECRET}";
        proxy_set_header Connection "";
    }
}
