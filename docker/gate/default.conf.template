# The only public port. Requests are accepted from the trusted reverse proxy (and loopback)
# by the TCP peer address; the proxy's X-Real-IP then identifies the visitor.

# realip rewrites $remote_addr before access checks, so trust is decided on the peer address.
geo $realip_remote_addr $from_trusted_peer {
    default 0;
    127.0.0.1 1;
    ${TRUSTED_PROXY_IP} 1;
}

# Only API calls are limited; one page load fetches many static chunks.
limit_req_zone $binary_remote_addr zone=api:10m rate=120r/m;

server {
    listen 8080;
    server_tokens off;
    client_max_body_size 1m;

    set_real_ip_from ${TRUSTED_PROXY_IP};
    real_ip_header X-Real-IP;

    if ($from_trusted_peer = 0) {
        return 403;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        limit_req_status 429;
        include /etc/nginx/conf.d/proxy.inc;
    }

    location / {
        include /etc/nginx/conf.d/proxy.inc;
    }
}
