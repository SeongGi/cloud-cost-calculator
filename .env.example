# Copy to .env (never commit .env).

# Local Ollama only. Containers reach the host through host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:latest

# Public port (the reverse proxy forwards to this port).
PUBLIC_PORT=8095
# IP of the reverse proxy allowed to reach PUBLIC_PORT. Unset = loopback only.
TRUSTED_PROXY_IP=

# Agent runs per IP per minute.
RATE_LIMIT_MAX=10

# Daily price refresh at 04:00 KST. Off by default: the bundled catalogs are used as they are.
PRICE_REFRESH=false
# Only for rebuilding GCP prices by hand: output of `gcloud auth print-access-token`.
# It expires in about an hour, so the daily refresh cannot rebuild GCP.
GCP_ACCESS_TOKEN=
