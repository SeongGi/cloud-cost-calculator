# Copy to .env (never commit .env).

# Local Ollama only. Containers reach the host through host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:latest

# Public port (the reverse proxy forwards to this port).
PUBLIC_PORT=8095
# Peer address of the reverse proxy as the gate sees it. Unset = loopback only.
# With OrbStack/Docker Desktop port publishing every connection shows the runtime's gateway
# (e.g. 192.168.171.1), not the proxy's LAN IP; check `docker compose logs gate`.
TRUSTED_PROXY_IP=
# Required (32+ letters/digits) when TRUSTED_PROXY_IP is set. The proxy sends it as
# `proxy_set_header X-Proxy-Secret <value>;`. Generate: LC_ALL=C tr -dc A-Za-z0-9 </dev/urandom | head -c 48
PROXY_SECRET=

# Agent runs per IP per minute.
RATE_LIMIT_MAX=10

# Daily price refresh at 04:00 KST. Off by default: the bundled catalogs are used as they are.
PRICE_REFRESH=false
# Only for rebuilding GCP prices by hand: output of `gcloud auth print-access-token`.
# It expires in about an hour, so the daily refresh cannot rebuild GCP.
GCP_ACCESS_TOKEN=

# Admin page at /admin (Google login via oauth2-proxy). Leave COMPOSE_PROFILES empty to run without it.
# Register https://<your host>/oauth2/callback as a redirect URI on the Google OAuth client.
COMPOSE_PROFILES=
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
ADMIN_PUBLIC_URL=https://cost.example.com
ADMIN_PUBLIC_HOST=cost.example.com
# Also list the same addresses in docker/auth/allowed-emails.txt (one per line).
ADMIN_EMAILS=
# 32+ letters/digits each: app -> agent token, and the gate's mark on signed-in admin requests.
ADMIN_TOKEN=
ADMIN_GATE_SECRET=
# Optional: Gemini key used until one is saved on the admin page.
GEMINI_API_KEY=
